{
  "name": "@evergreen-terrace/common",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./logger": {
      "import": "./dist/logger.js",
      "types": "./dist/logger.d.ts",
      "default": "./dist/logger.js"
    }
  },
  "scripts": {
    "build": "bun build/index.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "debug": "^4.4.0",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@evergreen-terrace/build-utils": "workspace:*",
    "@evergreen-terrace/config": "workspace:*",
    "@types/bun": "latest",
    "@types/debug": "^4.1.12",
    "typescript": "^5.7.3"
  }
}
