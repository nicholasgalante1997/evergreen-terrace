# Path to the repo root — used by queue-server, sentinel, and conductor
# to resolve queue/, context/, and agents/ directories.
QUEUE_ROOT=/home/nicks-dgx/dev/evergreen-terrace

# Full path to the claude CLI binary.
# Find yours with: which claude
CLAUDE_PATH=/home/nicks-dgx/.local/bin/claude

# Evergreen v1 local service topology. Generate unique local values; do not
# commit the resulting .env file.
ET_POSTGRES_ADMIN_PASSWORD=replace-with-a-local-secret
ET_COMMAND_DATABASE_PASSWORD=replace-with-a-local-secret
ET_PROJECTION_DATABASE_PASSWORD=replace-with-a-local-secret
ET_READ_API_DATABASE_PASSWORD=replace-with-a-local-secret

# Optional host-bridge override. The bridge defaults to this loopback URL.
ET_COMMAND_API_URL=http://127.0.0.1:7410

# Optional native host factory root. Worktrees and immutable local provenance
# records live here, outside active repositories. Defaults to
# $XDG_STATE_HOME/evergreen-terrace or ~/.local/state/evergreen-terrace.
ET_FACTORY_ROOT=
