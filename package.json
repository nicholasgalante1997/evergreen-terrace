{
  "name": "@evergreen-terrace/root",
  "description": "Personal engineering org — agent team, work queue, and momentum sentinel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "core/*",
    "docsite",
    "packages/*",
    "internal/*"
  ],
  "engines": {
    "bun": ">=1.3.13"
  },
  "packageManager": "bun@1.3.13",
  "scripts": {
    "format": "prettier --write core packages docsite",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "start": "bun scripts/start.ts",
    "start:dev": "bun scripts/start.ts --no-build",
    "start:headless": "bun scripts/start.ts --no-browser",
    "queue": "bun run core/queue-server/dist/index.js",
    "metrics": "bun run core/metrics/dist/index.js",
    "tui": "bun run core/tui/dist/index.js",
    "sentinel": "bun run core/sentinel/dist/index.js",
    "conductor": "bun run core/conductor/dist/index.js",
    "dashboard": "bun run --cwd core/web dev",
    "sync-agents": "bun scripts/sync-agents.ts",
    "health": "for port in 2727 2729 2730 2731; do curl -s -o /dev/null -w \"$port: %{http_code}\\n\" http://localhost:$port/health; done"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.8.3",
    "turbo": "^2.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.0.0"
  }
}
